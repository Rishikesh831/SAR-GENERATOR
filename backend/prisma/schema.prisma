generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Case {
  id     String     @id @default(uuid())
  status CaseStatus @default(INGESTED)

  // Layer 3 & 4: Intelligence Results
  riskScore Decimal?   @db.Decimal(3, 2) // e.g., 0.94
  riskLevel RiskLevel? @default(LOW) // LOW, MEDIUM, HIGH

  // Layer 4 & 5: Complex ML Insights
  // Stores Smurfing/Funneling patterns, SHAP values, and Graph data
  mlInsights Json?

  // Layer 6: AI Narrative
  summaryLlm String? @db.Text

  // Metadata
  assignedTo String? // User ID of the analyst
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  transactions Transaction[]
  auditLogs    AuditLog[]
  evidence     Evidence[]
}

enum CaseStatus {
  INGESTED
  ENRICHING
  ANALYZING
  GENERATING_NARRATIVE
  COMPLETED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Transaction {
  id     String @id @default(uuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  externalTxId String? // ID from the original bank CSV/API
  amount       Decimal  @db.Decimal(15, 2)
  currency     String   @default("INR")
  timestamp    DateTime

  // Layer 2: Enrichment (Optional)
  senderDetails   Json // { "acc_id": "A756", "name": "...", "country": "India" }
  receiverDetails Json // { "acc_id": "A421", "name": "...", "country": "UAE" }

  category  String? // e.g., "Wire Transfer", "ATM Withdrawal"
  isFlagged Boolean @default(false)
}

model Evidence {
  id     String @id @default(uuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  evidenceType String // e.g., "SMURFING_PATTERN", "VELOCITY_SPIKE"
  description  String // e.g., "108 small transactions in 24 hours"

  // Array of Transaction IDs that prove this evidence
  linkedTxIds String[]

  createdAt DateTime @default(now())
}

model AuditLog {
  id     String @id @default(uuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  action String // e.g., "STATUS_CHANGE", "ML_ANALYSIS_COMPLETED"
  actor  String // e.g., "SYSTEM" or "ANALYST_NAME"

  // Snapshot of what changed (e.g., old_status -> new_status)
  payload Json?

  timestamp DateTime @default(now())
}
